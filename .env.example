NODE_ENV=development

PORT=3010

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=school_fee

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string
JWT_REFRESH_EXPIRES_IN=30d

# Separate secret for parent-portal tokens (parent enters a student's
# identifierCode to reach that student's payment page) — must differ from
# JWT_SECRET so a parent token can never be replayed against staff endpoints.
PARENT_JWT_SECRET=change-me-to-yet-another-long-random-string
PARENT_JWT_EXPIRES_IN=30d

PAYMENT_PROVIDER=VIETQR

BANK_CODE=
BANK_ACCOUNT_NUMBER=
BANK_ACCOUNT_NAME=

PAYMENT_ORDER_EXPIRES_MINUTES=60
PAYMENT_WEBHOOK_SECRET=

# VietinBank eBank Biz collection API — see src/viettinbank/README.md
VIETINBANK_BASE_URL=
VIETINBANK_CLIENT_ID=
VIETINBANK_CLIENT_SECRET=
VIETINBANK_PROVIDER_ID=9752
VIETINBANK_MERCHANT_ID=9752
# Virtual sub-account prefix (VAC, per VietinBank's spec: custCode = VAC + VAV);
# the order's own transferContent (VAV) is appended to it to build the full
# accountNumber/custCode. Both the generate-QR client and the inq-bill/
# notify-bill handlers strip this prefix back off inbound custCode values.
VIETINBANK_ACCOUNT=
VIETINBANK_PRIVATE_KEY_PATH=./certs/viettinbank/private.pem
VIETINBANK_PUBLIC_KEY_PATH=./certs/viettinbank/public.pem
VIETINBANK_NOTIFY_CERT_PATH=./certs/viettinbank/notify-cert.pem

CORS_ORIGINS=http://localhost:3000

# Zalo Notification Service (ZNS) — sends the payment QR to a parent's Zalo
# account. Requires a registered Zalo Official Account + App at
# https://developers.zalo.me and a ZNS template already approved for this OA.
# ZALO_INITIAL_REFRESH_TOKEN is only needed once, to bootstrap the very first
# token pair (obtained via the OA's OAuth authorization code exchange); after
# that the backend persists and auto-rotates the refresh token itself.
ZALO_OA_ID=
ZALO_APP_ID=
ZALO_APP_SECRET=
ZALO_ZNS_TEMPLATE_ID=
ZALO_INITIAL_REFRESH_TOKEN=

# Redis/BullMQ workers used by the electronic-invoice pipeline.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Viettel S-Invoice. Credentials belong in deployment secrets only.
VIETTEL_SINVOICE_ENABLED=false
VIETTEL_SINVOICE_AUTO_ISSUE=true
VIETTEL_SINVOICE_BASE_URL=https://api-vinvoice.viettel.vn/services/einvoiceapplication/api/
VIETTEL_SINVOICE_AUTH_URL=https://api-vinvoice.viettel.vn/auth/login
VIETTEL_SINVOICE_WEB_URL=https://vinvoice.viettel.vn
VIETTEL_SINVOICE_USERNAME=
VIETTEL_SINVOICE_PASSWORD=
VIETTEL_SINVOICE_TAX_CODE=
VIETTEL_SINVOICE_TEMPLATE_CODE=
VIETTEL_SINVOICE_SERIES=
VIETTEL_SINVOICE_TIMEOUT=90000
VIETTEL_SINVOICE_AUTH_MODE=TOKEN
VIETTEL_SINVOICE_FILE_STORAGE_PATH=./storage/einvoices

# VERIFY_VIETTEL_METHOD: configure only after checking Viettel's test system.
VIETTEL_SINVOICE_METHOD_CREATE_WITH_CODE=
VIETTEL_SINVOICE_METHOD_GET_TEMPLATES=
VIETTEL_SINVOICE_METHOD_GET_ALL_INVOICES=
VIETTEL_SINVOICE_METHOD_GET_INVOICES_ALL=
