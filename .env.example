NODE_ENV=development

PORT=3010

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=school_fee

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string
JWT_REFRESH_EXPIRES_IN=30d

# Separate secret for parent-portal tokens (parent enters a student's
# identifierCode to reach that student's payment page) — must differ from
# JWT_SECRET so a parent token can never be replayed against staff endpoints.
PARENT_JWT_SECRET=change-me-to-yet-another-long-random-string
PARENT_JWT_EXPIRES_IN=30d

PAYMENT_PROVIDER=VIETQR

BANK_CODE=
BANK_ACCOUNT_NUMBER=
BANK_ACCOUNT_NAME=

PAYMENT_ORDER_EXPIRES_MINUTES=60
PAYMENT_WEBHOOK_SECRET=

# VietinBank eBank Biz collection API — see src/viettinbank/README.md
VIETINBANK_BASE_URL=
VIETINBANK_CLIENT_ID=
VIETINBANK_CLIENT_SECRET=
VIETINBANK_PROVIDER_ID=9752
VIETINBANK_MERCHANT_ID=9752
# Virtual sub-account prefix; the order's transferContent is appended to it
VIETINBANK_ACCOUNT=
VIETINBANK_PRIVATE_KEY_PATH=./certs/viettinbank/private.pem
VIETINBANK_PUBLIC_KEY_PATH=./certs/viettinbank/public.pem
VIETINBANK_NOTIFY_CERT_PATH=./certs/viettinbank/notify-cert.pem

CORS_ORIGINS=http://localhost:3000

# Zalo Notification Service (ZNS) — sends the payment QR to a parent's Zalo
# account. Requires a registered Zalo Official Account + App at
# https://developers.zalo.me and a ZNS template already approved for this OA.
# ZALO_INITIAL_REFRESH_TOKEN is only needed once, to bootstrap the very first
# token pair (obtained via the OA's OAuth authorization code exchange); after
# that the backend persists and auto-rotates the refresh token itself.
ZALO_OA_ID=
ZALO_APP_ID=
ZALO_APP_SECRET=
ZALO_ZNS_TEMPLATE_ID=
ZALO_INITIAL_REFRESH_TOKEN=
